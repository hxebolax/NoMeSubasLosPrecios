<?xml version="1.0" encoding="utf-8"?>
<!-- Copia en la nube y paso a otro móvil (Android 12 y posteriores): base de datos y ajustes -->
<data-extraction-rules>
	<cloud-backup>
		<include domain="database" path="nomesubaslosprecios.db" />
		<include domain="sharedpref" path="." />
	</cloud-backup>
	<device-transfer>
		<include domain="database" path="nomesubaslosprecios.db" />
		<include domain="sharedpref" path="." />
	</device-transfer>
</data-extraction-rules>
