<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal: barra con el nombre de la sección, estado, lista y botón «Añadir producto» -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/raiz"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?android:attr/colorBackground">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">

		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/barra"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize" />

		<!-- Progreso de la comprobación: cambia a menudo, así que no es región viva -->
		<TextView
			android:id="@+id/progreso"
			style="@style/Texto.Estado"
			android:visibility="gone" />

		<!-- Resultados (comprobación terminada, búsqueda...): región viva educada -->
		<TextView
			android:id="@+id/estado"
			style="@style/Texto.Estado"
			android:accessibilityLiveRegion="polite"
			android:visibility="gone" />

		<TextView
			android:id="@+id/vacio"
			style="@style/Texto.Vacio"
			android:visibility="gone" />

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/lista"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:clipToPadding="false"
			android:paddingBottom="88dp" />
	</LinearLayout>

	<com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
		android:id="@+id/anadir"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom|end"
		android:layout_margin="16dp"
		android:text="@string/anadir_producto"
		app:icon="@drawable/ic_anadir" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
