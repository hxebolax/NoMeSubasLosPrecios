# Se copia como .gitignore en la raíz del proyecto (lo hace tools/crear_proyecto.py).

# Entorno virtual y artefactos de Python.
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Compilación y empaquetado.
build/
dist/

# Datos generados en data/ al usar la aplicación: personales, nunca se versionan.
# Lo que SÍ se versiona de data/: bin/, sounds/, locales/, docs/, icons/, plugins/.
data/config/
data/logs/
data/db/
data/cache/
data/temp/
data/sessions/
data/backups/
data/downloads/

# Copia de ../compartido/recursos que hace entorno.bat (el original está en compartido).
data/recursos/
# Datos del navegador integrado (cookies de las tiendas).
data/cache/
# Paquetes listos para publicar.
dist/
